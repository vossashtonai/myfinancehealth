# Copy to .env and fill in. Never commit .env.

# Password for the sign-in screen. Required when deployed; optional locally (blank = no sign-in).
APP_PASSWORD=
# Optional: signs the session cookie. Defaults to one derived from APP_PASSWORD.
# AUTH_SECRET=

# AI assistant: set ONE of these. On Vercel, neither is needed (it uses Vercel AI Gateway via OIDC).
ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5          (when using ANTHROPIC_API_KEY)
# AI_GATEWAY_MODEL=anthropic/claude-opus-5.5   (when using AI Gateway)
# PORT=3000
